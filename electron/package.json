{
  "name": "scorelab-desktop",
  "private": true,
  "version": "2.3.1",
  "description": "ScoreLab을 설치형 데스크톱 앱(.exe)으로 감싸는 Electron 셸 - server/client 코드는 그대로 두고 실행 방식만 추가한다.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-app": "node prepare.mjs",
    "dist": "node build.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.scorelab.app",
    "productName": "ScoreLab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": ".staging/app",
        "to": "app"
      },
      {
        "from": ".staging/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "artifactName": "ScoreLab-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScoreLab",
      "license": ".staging/license-ko.rtf",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
